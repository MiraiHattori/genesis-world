FROM rocm/pytorch:rocm7.2.3_ubuntu22.04_py3.10_pytorch_release_2.9.1

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace/genesis-world

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    ffmpeg \
    git \
    gosu \
    libegl1 \
    libgl1 \
    libgl1-mesa-dri \
    libglib2.0-0 \
    libglu1-mesa \
    libglvnd0 \
    libglx0 \
    libvulkan1 \
    mesa-vulkan-drivers \
    tmux \
    vulkan-tools \
    wget \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# handle add the render group
RUN groupadd -f render
RUN usermod -aG render root
RUN usermod -aG video root

# Headless Genesis builds an offscreen rasterizer even when show_viewer=False.
ENV PYOPENGL_PLATFORM='egl'

# Keep PyTorch from the ROCm base image and install this checkout editable.
COPY . /workspace/genesis-world
RUN python3 -m pip install --no-cache-dir --upgrade pip "setuptools<81" wheel \
    && python3 -m pip install --no-cache-dir -e ".[render]" \
    && python3 -m pip install --no-cache-dir libigl==2.5.1

RUN cat <<'EOF' > /entrypoint.sh
#!/bin/bash
set -e

add_device_group() {
    local path="$1"
    local fallback_name="$2"
    if [ ! -e "${path}" ]; then
        return
    fi
    local gid
    gid="$(stat -c '%g' "${path}")"
    local group_name
    group_name="$(getent group "${gid}" | cut -d: -f1)"
    if [ -z "${group_name}" ]; then
        group_name="${fallback_name}_${gid}"
        groupadd --gid "${gid}" "${group_name}"
    fi
    usermod -aG "${group_name}" "${USER_NAME}"
}

if [ -n "${LOCAL_USER_ID}" ]; then
    USER_NAME=$(getent passwd "${LOCAL_USER_ID}" | cut -d: -f1)
    if [ -z "${USER_NAME}" ]; then
        USER_NAME=genesis
        useradd --shell /bin/bash --uid "${LOCAL_USER_ID}" -m "${USER_NAME}"
    fi
    usermod -aG video,render "${USER_NAME}" || true
    add_device_group /dev/kfd kfd
    add_device_group /dev/dri/renderD128 dri_render
    add_device_group /dev/dri/card1 dri_card
    chown -R "${USER_NAME}" /workspace/genesis-world || true
    exec gosu "${USER_NAME}" "$@"
else
    exec "$@"
fi
EOF
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
